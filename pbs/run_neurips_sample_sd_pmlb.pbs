#!/bin/bash
#PBS -N nips-sd-pmlb
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=24:00:00
#PBS -J 0-11
#PBS -o logs/
#PBS -e logs/

# Submit from BanachKAN after committing previous results:
# qsub -N nips-sd-pmlb pbs/run_neurips_sample_sd_pmlb.pbs
# Optional pilot: add -J 0; remaining datasets: add -J 1-11.
# Replaces canonical PMLB fits; sample SD for feature/target scaling and NRMSE.
# Reuses the existing data cache; downloads only missing datasets.
# No GPU locks or nested scheduler launchers.
# PBS_ARRAY_INDEX=0 bash pbs/run_neurips_sample_sd_pmlb.pbs --dry-run
set -euo pipefail
cd "${PBS_O_WORKDIR:-$HOME/BanachKAN}"
MODE=${1:-run}
[[ "$MODE" == run || "$MODE" == --dry-run ]] || exit 2
INDEX=${PBS_ARRAY_INDEX:-}
[[ "$INDEX" =~ ^[0-9]+$ ]] && ((10#$INDEX < 12)) || exit 2
WORKERS=${PMLB_WORKERS:-${PBS_NCPUS:-16}}
[[ "$WORKERS" =~ ^[0-9]+$ ]] && ((WORKERS > 0)) || exit 2
COMMAND=(python -u experiments/neurips_pmlb15.py run --dataset-idx "$INDEX"
  --out experiments/results/neurips_pmlb15/pmlb15_pbs_v1
  --cache "${PMLB_CACHE:-experiments/results/pmlb_cache}" --workers "$WORKERS" --replace-existing)
if [[ "$MODE" == --dry-run ]]; then printf '%q ' "${COMMAND[@]}"; printf '\n'; exit 0; fi
CONDA_TOOL=${KAN_CONDA_EXE:-$HOME/miniforge3/bin/conda}
if [[ ! -x "$CONDA_TOOL" && -z "${KAN_CONDA_EXE:-}" ]]; then CONDA_TOOL=$HOME/miniconda3/bin/conda; fi
[[ -x "$CONDA_TOOL" ]] || { echo 'Set KAN_CONDA_EXE'; exit 2; }
eval "$("$CONDA_TOOL" shell.bash hook)"
conda activate "${SAMPLE_SD_ENV:-banach_kan}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
echo "sample-SD PMLB | case=$INDEX | source=$(git rev-parse HEAD) | $(date -Is)"
"${COMMAND[@]}"
